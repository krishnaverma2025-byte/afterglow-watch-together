{
  "manifest_version": 3,
  "name": "Afterglow \u2014 Streaming parties",
  "version": "1.0.1",
  "description": "Create and join independent watch parties on Netflix, Prime Video and Hotstar. Each viewer uses their own streaming access.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://afterglow-watch-together-kv.amused-gem-5551.chatgpt.site/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Afterglow party"
  }
}
